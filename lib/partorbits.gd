#! @Chapter partorbits


#! @Section Types and Families

#! @Description
#! The abstract data type of partial partitions. All concrete types of partial partitions
#! are derived from this type
DeclareCategory( "IsCocoPartialPartition", IsObject );

#! @Description 
#! The data type of partial partitions
DeclareCategory( "IsPartialPartition", IsCocoPartialPartition );

#! @Description
#! The data type of orbits of partial partitions
DeclareCategory( "IsPartitionOrbit", IsCocoPartitionOrbit );

#! @Description
#! The Family of orbits of partial partitions over the permutation group <A>grp</A>.
#! @Arguments grp
DeclareAttribute( "PartialPartitionOrbitsFamily", IsPermGroup );


#! @Section Constructors


#! @Description
#! This function gets as input a list of set orbits --- all over the same group, and 
#! returns an empty partial partition. The partitios that may be derived from this 
#! will be constructed from the elements of the given set-orbits.
#! @Arguments cgr
DeclareOperation( "EmptyPartialPartition", [IsList] );


#! @Description
#! `ExtendedPartialPartition` extends the partial partition <A>ppart</A> with
#! by a set <A>set</A>. If this is impossible for some reason, then `fail` is returned,
#! otherwise the new extended partial stable partition is returned.
#! @Arguments ppart,set
DeclareOperation( "ExtendedPartialPartition", [IsCocoPartialPartition, IsList] );


#! @Description This operation translates from the data type of partial  partitions to
#! the corresponding data type of partitions. Its input is a complete partial 
#! partition <A>ppart</A>. Its output is the corresponding  partition (as a 
#! short-lex sorted list of sets).
#! @Arguments pgs
DeclareOperation( "PartitionFromCompletePartialPartition", [IsCocoPartialPartition ] );


#! @BeginGroup GrpColorPartitionOrbit
#! @Description
#! `PartitionOrbitNC` expects as input a permutation group <A>grp</A>, a partition
#! <A>part</A> (as list of sets, ordered short-lex), and a subgroup <A>stab</A> of <A>grp</A>. It expects
#! * <A>grp</A> to be a permutation group,
#! * <A>part</A> to be the smallest element of its orbit under
#!   <A>grp</A> (with respect to lexicographic ordering (sets being ordered by short-lex),
#! * <A>stab</A> to be the stabilizer of <A>part</A> in <A>grp</A> (OnPartitions).
#! None of this is checked. The function returns an object representing the orbit of <A>part</A>
#! under <A>grp</A> with respect to the action `OnPartitions`.
#!
#! `PartitionOrbit` gets the same kind of input like `PartitionOrbitNC`. However, its
#! expectations on this input are weaker. It expects:
#! * <A>grp</A> to be a permutation group,
#! * <A>stab</A> to be a subgroup of the stabilizer of <A>part</A> in <A>grp</A> (`OnPartitions`).
#! The second expectation is not checked either. Otherwise it does the same like
#! `PartitionOrbitNC`.
#! @Arguments grp,part[,stab]
DeclareGlobalFunction( "PartitionOrbit" );
#! @Arguments grp,part[,stab]
DeclareGlobalFunction( "PartitionOrbitNC" );
#! @EndGroup


#! @Description
#! Constructs a new object representing the orbit of the partial partiton <A>ppart</A>
#! under the permutation group <A>grp</A>. The following expectations are made on the input:
#! * The stabilizer `OnSetsSets` of `Set(<A>ppart</A>!.ppart)` in <A>grp</A> is equal to <A>stab</A>;
#! * ppart is the smallest element in its orbit with respect to the short lex ordering.
#! It is not checked whether these conditions are acually fulfilled.
#! @Arguments grp,ppart,stab
DeclareGlobalFunction( "PartialPartitionOrbitNC" );



#! @Description
#! This implements the action of permutations on partitions. 
#! @Arguments part, prm
DeclareGlobalFunction( "OnPartitions");


#! @Section Properties

#! @BeginGroup partproperties
#! @Description
#! These properties are described in Chapter <Ref Sect='Chapter_pstabfus'/>. 
DeclareProperty( "IsIrredundantPartialPartition", IsCocoPartialPartition );
DeclareProperty( "IsCompletePartialPartition", IsCocoPartialPartition );
DeclareProperty( "HasSmallerBase", IsCocoPartialPartition );
#! @EndGroup

#! @Section Functions for the inspection of  partitions

#! @Description
#! Returns the number of classes of the partition generated by the partial partition <A>ppart</A>.
#! @Arguments ppart
DeclareAttribute( "RankOfPartialPartition", IsCocoPartialPartition );

#! @Description
#! Returns `true` is <A>set</A> is greater than the largest class of <A>ppart</A> (with respect 
#! to short-lex) and at the same time is disjoint from any of the classes of <A>ppart</A>.
#! Otherwise it returns `false`.
#! @Arguments ppart, set
DeclareOperation( "IsCompatibleWithPartialPartition", [IsCocoPartialPartition, IsList] );

#! @Description
#! Returns the underlying ordered partial partition of <A>ppart</A>.
#! @Arguments ppart
DeclareOperation( "UnderlyingListOfSets", [IsCocoPartialPartition] );



################################################################################

#! @Section Iterators of partition orbits

#! @Description 
#! The data type of iterators of orbits of partial partitions
DeclareCategory( "IsIteratorOfPPOrbits", IsIterator );


#! @Description
#! This operation gets as input a set of positive integers (representing the domain)
#! and a list <A>sorb</A> of set-orbits os subsets of <A>domain</A>, all over the same group 
#! $G$. It returns an iterator of all $G$-orbits of partial partitions of <A>dom</A> consisting 
#! only of sets from the set-orbits from <A>sorb</A>. If the option `maxrank:=r` is given, then 
#! only partial partitions are returned whose rank does not exceed `r`. 
#! 
#! Suppose that <A>sorb</A> is equal to $\{M_1,\dots,M_k\}$. We can enumerate the orbits 
#! arbitrarily by assigning each of them a distinct number from $\{1,\dots,k\}$. This may be done 
#! through an assignment like `sorb[i]!.type:=j`, where `j` is the desired index. If such an 
#! indexing has been done before calling `IteratorOfPPOrbits`, then the option
#! `:hasTypes` should be given. If this option is not given, then each orbit gets as a type
#! its index in <A>sorb</A> (e.g. `sorb[i]!.type:=i`). 
#! When the types of the orbits are assigned (directly or indirectly), then the option
#! `:orbitBounds:=ob` can be given. The list `ob` should have length $k$ and should
#! consist of non-negative integers. If `ob[j]=m`, then only such partial partitions get 
#! constructed that have at most `m` classes from the orbit `sorb[i]` with `sorb[i]!.type=j`.
#! @Arguments dom, sorb :maxrank:=r, hasTypes, orbitBounds:=ob
DeclareOperation( "IteratorOfPPOrbits", [IsList, IsList] ); 



#! @Description
#! This function gets as input an iterator of orbits of partial  partitions 
#! (not necessarily in initial state). It iterates the iterator till the end and returns 
#! all orbits of partitions encountered on the way. As a side effect, the iterator 
#! is spent (done) et the end.
#! @Arguments iter
DeclareOperation( "AllPartitionOrbits", [IsIteratorOfPPOrbits] );  

#! @Description
#! As they are implemented, iterators of partition orbits know the next partial partition
#! orbit before `NextIterator` is invoked. The function NextPartialPartitionOrbit returns the 
#! orbit of the partial partition `NextIterator<A>(iter</A>)` without changing the state of 
#! <A>iter</A>.
#! @Arguments iter
DeclareOperation( "NextPartialPartitionOrbit", [IsIteratorOfPPOrbits] );


#! @Description
#! Suppose that `NextPartialPartitionOrbit(<A>iter</A>)` returnes the partial partition orbit
#! with lexicographically smallest representative $(M_1,\dots,M_k)$. Then invoking 
#! `RejectPartialPartitionOrbit(<A>iter</A>)` 
#! has the effect that the iterator cuts off all partial partition orbits whose smallest 
#! representatives contain have $$(M_1,\dots,M_k)$$ as a prefix. 
DeclareOperation( "RejectPartialPartitionOrbit", [IsIteratorOfPPOrbits] );
